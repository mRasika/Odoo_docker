    E0727, # misplaced-complex-literal
    E0728, # misplaced-imaginary-literal
    E0729, # misplaced-integer-literal
    E0730, # misplaced-string-literal
    E0731, # misplaced-bytes-literal
    E0732, # misplaced-set-literal
    E0733, # misplaced-list-literal
    E0734, # misplaced-dict-literal
    E0735, # misplaced-tuple-literal
    E0736, # misplaced-none-literal
    E0737, # misplaced-true-literal
    E0738, # misplaced-false-literal
    E0739, # misplaced-ellipsis-literal
    E0740, # misplaced-await-expression
    E0741, # misplaced-yield-expression
    E0742, # misplaced-starred-expression
    E0743, # misplaced-lambda-expression
    E0744, # misplaced-if-expression
    E0745, # misplaced-dict-comprehension
    E0746, # misplaced-list-comprehension
    E0747, # misplaced-set-comprehension
    E0748, # misplaced-generator-expression
    E0749, # misplaced-call-expression
    E0750, # misplaced-attribute-expression
    E0751, # misplaced-subscript-expression
    E0752, # misplaced-slice-expression
    E0753, # misplaced-comparison-expression
    E0754, # misplaced-binary-operation-expression
    E0755, # misplaced-unary-operation-expression
    E0756, # misplaced-assign-expression
    E0757, # misplaced-annotation-expression
    E0758, # misplaced-expression-statement
    E0759, # misplaced-assert-statement
    E0760, # misplaced-if-statement
    E0761, # misplaced-while-statement
    E0762, # misplaced-for-statement
    E0763, # misplaced-try-statement
    E0764, # misplaced-with-statement
    E0765, # misplaced-function-definition
    E0766, # misplaced-class-definition
    E0767, # misplaced-return-statement
    E0768, # misplaced-yield-statement
    E0769, # misplaced-raise-statement
    E0770, # misplaced-break-statement
    E0771, # misplaced-continue-statement

    W8113, # attribute-string-redundant
    W8163, # no-search-all
    C8101, # manifest-required-author

[FORMAT]
max-line-length=120
indent-string='    '
expected-line-ending-format=LF

[TYPECHECK]
ignored-modules=
    odoo,
    openerp,
    addons
ignored-classes=
    odoo.osv.osv.osv_next,
    odoo.addons.base.models.res_users.res_users,
    odoo.http.request,
    odoo.api.Environment

[DESIGN]
max-attributes=14
max-locals=15
max-returns=6
max-statements=50
max-parents=7
min-public-methods=0

[CLASSES]
exclude-protected=_api,_insert,_update

[METHOD_ARGS]
max-args=6

[BASIC]
good-names=
    _,
    env,
    cr,
    uid,
    self,
    cls,
    doc,
    recs,
    e
