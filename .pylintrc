    E0239, # keyword-arg-before-kwargs
    E0240, # redundant-keyword-arg
    E0241, # unexpected-keyword-arg
    E0301, # duplicate-argument
    E0302, # duplicate-value
    E0303, # invalid-arguments-for-classmethod
