    E1136, # unsubscriptable-object
    E1137, # unsupported-assignment-operation
    E1138, # unsupported-delete-operation
    E1139, # unsupported-binary-operation
    E1140, # unsupported-unary-operation
    W0621, # redefined-outer-name
    W1501, # yield-inside-async-function
    W1502, # using-yield-outside-function
    W1503, # redundant-returns-condition
    W1504, # cell-var-from-loop
    W1505, # used-before-assignment
    W1506, # undefined-loop-variable
    W1507, # line-ending-in-whitespace
    W1508, # no-else-return
    W1509, # no-else-raise
    W1510, # no-else-break
    W1511, # no-else-continue
    W1512, # bare-except
    W1513, # duplicate-except
    W1514, # misplaced-bare-raise
    W1515, # useless-object-inheritance
    W1516, # unnecessary-pass
    W1517, # unnecessary-dunder-call
    W1518, # useless-return
    W1519, # inconsistent-return-statements
    W1520, # missing-parentheses-for-call-in-test
